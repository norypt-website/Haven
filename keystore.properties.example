# Copy to keystore.properties (gitignored) on the release machine only.
# Keep the keystore OUTSIDE the repository. Passwords are read from the environment first:
#   HAVEN_STORE_PASSWORD, HAVEN_KEY_PASSWORD
# and only fall back to the two optional lines below.
storeFile=/absolute/path/outside/the/repo/haven-release.p12
keyAlias=haven-release
#storePassword=
#keyPassword=
