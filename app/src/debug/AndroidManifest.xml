<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- DEBUG BUILDS ONLY (this manifest lives in src/debug): lets automated tests trigger a test
             alarm from adb while the device is locked. Not present in release builds. -->
        <receiver
            android:name="com.norypt.haven.debug.DebugTriggerReceiver"
            android:exported="true"
            android:directBootAware="true">
            <intent-filter>
                <action android:name="com.norypt.haven.debug.TEST_ALARM" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
